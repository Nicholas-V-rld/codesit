# CodeSit configuration — copy to .env or export before `npm start`.
# Every value is optional; the defaults make the app run out of the box.

PORT=3000
SESSION_SECRET=change-me-in-production

# Execution engine: "wandbox" (default, free, no key) or "piston"
EXECUTOR=wandbox

# Only used when EXECUTOR=piston. For production, self-host Piston:
#   docker run -d -p 2000:2000 ghcr.io/engineer-man/piston
PISTON_URL=https://emkc.org/api/v2/piston
PISTON_TOKEN=
