# CodeSit configuration — copy to .env (it is loaded automatically).
# Every value is optional; the defaults make the app run out of the box.

PORT=3000
SESSION_SECRET=change-me-in-production
NODE_ENV=development

# --- Database -------------------------------------------------------------
# Unset: a local SQLite file (database/codesit.db). Set: PostgreSQL — required
# on Vercel, where the Neon integration sets it for you.
# DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# --- Where student code runs -------------------------------------------
# local  (default) runs code on THIS machine as a short-lived process in a
#        temp directory, killed after RUN_TIMEOUT_MS, output capped. Nothing
#        to install, no internet, no account: Run and automatic marking work
#        immediately. It is NOT a security sandbox — it is for development
#        and for a lecturer's own lab machine.
# sandbox Vercel Sandbox: an isolated microVM with no network. The default
#        on Vercel. Locally it needs `vercel link` + `vercel env pull .env.local`;
#        prepare it with `npm run sandbox:setup`.
# piston a real sandbox for a self-hosted deployment.
#        Self-host it (the public emkc.org endpoint stopped being freely
#        available on 15 Feb 2026):
#          docker run -d -p 2000:2000 ghcr.io/engineer-man/piston
#          EXECUTOR=piston PISTON_URL=http://localhost:2000/api/v2/piston npm start
# wandbox a free public sandbox needing no key — convenient, but it is a
#        shared community service and does have outages.
EXECUTOR=local

PISTON_URL=https://emkc.org/api/v2/piston
PISTON_TOKEN=

# Execution limits
RUN_TIMEOUT_MS=8000
OUTPUT_CAP_BYTES=65536
